#!/usr/bin/env python3
"""Synthetic inspection process. Never pass its marker files to real Blender."""

import json
import os
import subprocess
import sys
from pathlib import Path

if "--version" in sys.argv:
    print("Blender 5.2.0")
    raise SystemExit(0)

script = Path(sys.argv[sys.argv.index("--python") + 1]).name
if script == "inspect_devices.py":
    visible = os.environ.get("CUDA_VISIBLE_DEVICES")
    backends = ["OPTIX", "CUDA"] if visible in {"GPU-A", "MIG-B"} else []
    print("RENDER_NODE_INSPECTION " + json.dumps({"backends": backends}))
    raise SystemExit(0)

scene_path = next(Path(arg) for arg in sys.argv if arg.endswith(".blend"))
content = scene_path.read_bytes().decode()
if "HANG" in content:
    child = subprocess.Popen(["sleep", "60"])
    (Path.cwd().parent.parent / "inspection-child.pid").write_text(str(child.pid))
    child.wait()
if "FAIL" in content:
    raise SystemExit(7)
if "MALFORMED" in content:
    print("RENDER_NODE_INSPECTION {}")
    raise SystemExit(0)
metadata = json.loads(content.split("\n", 1)[1])
print("RENDER_NODE_INSPECTION " + json.dumps(metadata), flush=True)
