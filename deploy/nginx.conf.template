pid ${RENDER_NODE_RUNTIME_ROOT}/nginx.pid;
worker_processes auto;
error_log ${RENDER_NODE_STATE_ROOT}/logs/nginx-error.log warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    sendfile on;
    client_max_body_size 0;
    client_body_temp_path ${RENDER_NODE_RUNTIME_ROOT}/nginx-client-body;
    proxy_temp_path ${RENDER_NODE_RUNTIME_ROOT}/nginx-proxy;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen 8080;
        server_name _;

        auth_basic "Render Node";
        auth_basic_user_file ${RENDER_NODE_STATE_ROOT}/admin.htpasswd;

        location = /health {
            auth_basic off;
            proxy_pass http://127.0.0.1:8000;
        }

        location = /ready {
            auth_basic off;
            proxy_pass http://127.0.0.1:8000;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Authorization "Bearer ${RENDER_NODE_AUTH_TOKEN}";
        }

        location / {
            root ${RENDER_NODE_FRONTEND_ROOT};
            try_files $uri $uri/ /index.html;
        }
    }
}
