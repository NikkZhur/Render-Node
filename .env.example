RENDER_NODE_ENV=development
RENDER_NODE_WORKSPACE=/workspace
RENDER_NODE_DATABASE_URL=sqlite+aiosqlite:////workspace/database/render-node.sqlite3
RENDER_NODE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RENDER_NODE_MAX_UPLOAD_GB=20
RENDER_NODE_MAX_ZIP_FILES=10000
RENDER_NODE_MAX_ZIP_EXTRACTED_GB=50
RENDER_NODE_MAX_BLENDER_ARCHIVE_GB=2
RENDER_NODE_MAX_BLENDER_EXTRACTED_GB=8
RENDER_NODE_MAX_BLENDER_ARCHIVE_FILES=100000
RENDER_NODE_BLENDER_CATALOG_TTL_SECONDS=3600
RENDER_NODE_BLENDER_DOWNLOAD_TIMEOUT_SECONDS=3600
RENDER_NODE_RENDER_SCHEDULER_ENABLED=true
# Explicit development-only override. Production must use an OS-isolated worker.
RENDER_NODE_ALLOW_UNSANDBOXED_RUNNER=true
RENDER_NODE_RENDER_TIMEOUT_SECONDS=21600
RENDER_NODE_RENDER_TERMINATE_GRACE_SECONDS=5
RENDER_NODE_RENDER_SCHEDULER_POLL_SECONDS=0.5
RENDER_NODE_MAX_RENDER_OUTPUT_GB=20
RENDER_NODE_MAX_RENDER_LOG_MB=100
RENDER_NODE_WORKER_MEMORY_GB=16
RENDER_NODE_WORKER_PIDS_LIMIT=256
RENDER_NODE_PREVIEW_MAX_WIDTH=1280
RENDER_NODE_PREVIEW_MAX_HEIGHT=1280
RENDER_NODE_PREVIEW_MAX_MEGAPIXELS=100
RENDER_NODE_EVENT_QUEUE_SIZE=256
RENDER_NODE_METRICS_INTERVAL_SECONDS=1
RENDER_NODE_LOW_SPACE_PERCENT=10
RENDER_NODE_LOW_SPACE_GB=50
